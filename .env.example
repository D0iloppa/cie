# Can I Eat 환경변수 (복사해서 .env 로 사용)

# 서버 포트
PORT=3000

# DB — 공유 Postgres 컨테이너(devdb) 안의 전용 database `cie`
DB_HOST=devdb
DB_PORT=5432
DB_USER=doil
DB_PASSWORD=         # 공유 dev db 비밀번호 — .env 에만 채우고 절대 커밋하지 말 것
DB_NAME=cie

# AI 인증 — claude CLI(Claude Code) OAuth 토큰. `claude setup-token` 으로 발급.
# 없으면 AI 에이전트 비활성(결정론 폴백). sk-ant API 키 아님.
CLAUDE_CODE_OAUTH_TOKEN=
